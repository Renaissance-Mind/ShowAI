          },
          {
            "label": "了解技能",
            "href": "doc:skills"
          }
        ],
        "art": "agent"
      }
    },
    {
      "name": "无插图的参考页页首",
      "data": {
        "eyebrow": "开发参考",
        "title": "CLI 与 MCP 参考",
        "lead": "所有命令都读写同一个内容库，执行完即退出；工作台关闭时也能使用。",
        "art": "none"
      }
    }
  ]
}
