{
  "id": "doc-commands",
  "version": "1.0.0",
  "name": "文档命令参考",
  "description": "可搜索的命令参考：按分组筛选，搜索命令、用途和参数并高亮匹配；展开一条命令查看说明、参数表和可复制的示例。",
  "category": "other",
  "entry": "index.tsx",
  "reader": "readData",
  "scenarios": [
    "CLI 与 MCP 命令参考",
    "列出键盘快捷键、脚本或配置命令",
    "在长命令清单中按用途和参数查找"
  ],
  "documentation": {
    "version": 2,
    "reuse": {
      "kind": "domain",
      "boundaries": [
        "用于 ShowAI 文档中的命令、快捷键或脚本清单：每项一行命令加一句用途，可展开说明、参数和示例。",
        "适合 10–150 条；不用于需要排序或多列数值比较的数据表。",
        "只读展示：搜索、筛选和展开只改变本地视图，不修改页面数据。"
      ]
    },
    "usage": {
      "purpose": "让读者按任务找到命令：输入关键词或参数名立刻缩小范围，展开后直接复制示例。",
      "structure": [
        "顶部搜索框：同时匹配命令、用途和参数（参数名与说明）；多个关键词用空格分开，需全部匹配；匹配文字高亮。Esc 清空，↓ 进入列表。",
        "分组筛选：「全部」与每个分组，数字是当前搜索下的匹配数；再次点击已选分组回到「全部」。",
        "列表按分组分节：每行是等宽字体的命令（程序名淡化、子命令加粗、占位符淡化）和一句用途；只因参数匹配的命令会列出匹配的参数。",
        "展开一行显示 detail、参数表和带复制按钮的示例。没有 detail、flags、example 的命令不能展开。",
        "没有匹配时显示空状态，可清除搜索或回到全部分组。"
      ],
      "inputs": [
        {
          "path": "groups",
          "meaning": "分组，按显示顺序排列；建议 3–7 组。"
        },
        {
          "path": "groups[].id",
          "meaning": "分组标识，由 commands[].group 引用，唯一。"
        },
        {
          "path": "groups[].label",
          "meaning": "分组名称，显示在筛选按钮和分节标题上。"
        },
        {
          "path": "commands",
          "meaning": "命令，按显示顺序排列；同一分组的命令在该分组下按原顺序显示。最多 200 条，建议不超过 150 条。"
        },
        {
          "path": "commands[].group",
          "meaning": "所属分组的 id。不匹配任何分组的命令显示在最后的「其他」分组，readData 在 ungrouped 中列出。"
        },
        {
          "path": "commands[].command",
          "meaning": "命令行，原样以等宽字体显示。开头的 showai、./showai、npm、node 等程序名淡化；其后的第一个词是命令名并加粗，可以是 CLI 子命令或 MCP 工具名（如 page_read、showai_capabilities，可含 _ . -）；CLI 子命令后连续的小写单词（如 pages read）一并加粗，工具名之后不再加粗。以 - 开头的是参数，大写词（PAGE、PATH）视为占位符。"
        },
        {
          "path": "commands[].summary",
          "meaning": "一句话用途，显示在命令下方并参与搜索。纯文字。"
        },
        {
          "path": "commands[].detail",
          "meaning": "展开后的说明，支持 **粗体**、`代码`、[链接](href)；空行分段，以 \"- \" 开头的行成为列表。不参与搜索。",
          "omission": {
            "behavior": "omit",
            "description": "展开后不显示说明。"
          }
        },
        {
          "path": "commands[].flags",
          "meaning": "参数表，按顺序显示，参与搜索。",
          "omission": {
            "behavior": "omit",
            "description": "不显示参数表。detail、flags、example 都省略时该行不能展开。"
          }
        },
        {
          "path": "commands[].flags[].flag",
          "meaning": "参数写法，例如 --home PATH。同一命令内应唯一。"
        },
        {
          "path": "commands[].flags[].meaning",
          "meaning": "参数说明，支持行内标记。"
        },
        {
          "path": "commands[].example",
          "meaning": "可直接运行的示例，原样显示在带复制按钮的代码面板中；可以多行。",
          "omission": {
            "behavior": "omit",
            "description": "不显示示例面板。"
          }
        },
        {
          "path": "placeholder",
          "meaning": "搜索框的占位文字。",
          "omission": {
            "behavior": "fallback",
            "description": "显示「搜索命令、参数或用途」。",
            "value": "搜索命令、参数或用途"
          }
        }
      ],
      "recipes": [
        {
          "title": "整理一份 CLI 参考",
          "steps": [
            "按读者任务分 3–7 组（例如 运行与连接、项目与页面、展示与导出），不要按源码模块分。",
            "command 写帮助输出中的形式（大写占位符、方括号表示可选）；summary 写读者用它做什么。",
            "常用命令补 flags 和一条能直接运行的 example；冷门命令只写 summary。",
            "用 readData 检查 ungrouped 为空，每组数量合理。"
          ],
          "exampleIndex": 0
        }
      ],
      "interactions": [
        {
          "action": "在搜索框输入",
          "effect": "过滤命令并高亮匹配；分组按钮上的数字随之更新。Esc 清空，↓ 移到第一条命令。",
          "persistence": "view"
        },
        {
          "action": "点击分组按钮",
          "effect": "只显示该分组；再次点击回到全部。",
          "persistence": "view"
        },
        {
          "action": "点击命令行或按 Enter",
          "effect": "展开或收起说明、参数和示例；↑ ↓ 在命令之间移动。",
          "persistence": "view"
        },
        {
          "action": "点击复制",
          "effect": "复制示例；沙盒禁止复制时选中代码并提示按 ⌘C / Ctrl+C。",
          "persistence": "none"
        }
      ],
      "constraints": [
        "阅读操作不修改页面数据。",
        "搜索不区分大小写，按子串匹配命令、用途和参数；detail 与 example 不参与搜索。",
        "列表没有内部滚动，高度随显示的命令增长；命令很多时依靠分组和搜索缩短列表。"
      ],
      "editing": {
        "data": [
          "增删分组时同步更新 commands[].group。",
          "命令写法变化时同时更新 example。"
        ],
        "implementation": [
          "要让 detail 参与搜索或支持命令别名，需要新版本。"
        ]
      },
      "rules": [
        {
          "kind": "unique",
          "path": "groups[].id"
        },
        {
          "kind": "reference",
          "path": "commands[].group",
          "target": "groups[].id"
        }
      ]
    },
    "development": {
      "entryPoints": [
        {
          "path": "index.tsx",
          "purpose": "组件、搜索索引 prepare()、匹配与高亮 ranges() / marked()、命令着色 CommandLine、CodePanel、md() / mdBlock() 与 readData。"
        },
        {
          "path": "style.css",
          "purpose": "设计令牌（含深色）、搜索框、分组按钮、列表、展开详情、参数表、代码面板、空状态与窄屏规则。"
        }
      ],
      "architecture": [
        "prepare() 为每条命令预先计算小写的命令、用途和参数文本；每次输入只做子串比较，100 条以上也无需防抖。搜索词通过 useDeferredValue 延后过滤，输入保持流畅。",
        "高亮在整条命令文字上计算匹配区间，再按词元切分渲染，因此跨越子命令与参数的关键词（如 \"pages read\"）也能完整高亮。",
        "展开状态以命令下标为键保存在本地 Set 中，搜索和筛选不会重置。"
      ],
      "extensionPoints": [
        "命令词元的分类规则在 CommandLine 中；空状态的建议在组件末尾。"
      ],
      "invariants": [
        "组件不调用 onChange；所有交互只改变本地状态。",
        "不使用 dangerouslySetInnerHTML；高亮与行内标记都生成 React 元素。"
      ],
      "verification": [
        "示例 0：5 组 40 条；搜索 theme 只剩 pages read 并在行内列出匹配参数 --theme dark；搜索 \"pages read\" 高亮两个词。",
        "搜索不存在的词显示空状态；在某个分组中搜索其他分组的命令时提供「在全部分组中查看」。",
        "在 1000 px、390 px 与深色主题下检查搜索框、分组、展开的参数表与代码面板。"
      ]
    }
  },
