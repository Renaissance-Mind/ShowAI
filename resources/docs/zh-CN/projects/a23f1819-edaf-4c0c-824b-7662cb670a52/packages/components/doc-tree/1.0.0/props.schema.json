  },
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "initial": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  },
  "required": [
    "nodes"
  ],
  "additionalProperties": false
}
