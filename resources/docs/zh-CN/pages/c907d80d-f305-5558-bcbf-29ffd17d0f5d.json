mjs verify","summary":"核验一份备份","flags":[{"flag":"--backup","meaning":"备份目录"}]},{"group":"backup","command":"node scripts/server-backup.mjs restore","summary":"把备份恢复到新的数据目录（保持冻结）","flags":[{"flag":"--backup","meaning":"备份目录"},{"flag":"--home","meaning":"新的绝对路径数据目录"}]},{"group":"switch","command":"node scripts/server-backup.mjs state","summary":"查询冻结状态和当前代号","flags":[{"flag":"--url","meaning":"服务器基址"},{"flag":"--key-file","meaning":"运维密钥文件"}]},{"group":"switch","command":"node scripts/server-backup.mjs freeze","summary":"冻结服务器，拒绝后续写入","flags":[{"flag":"--url","meaning":"服务器基址"},{"flag":"--key-file","meaning":"运维密钥文件"}]},{"group":"switch","command":"node scripts/server-backup.mjs unfreeze","summary":"用当前代号重新打开选定的服务器","flags":[{"flag":"--epoch","meaning":"state 或 restore 返回的冻结代号"}]},{"group":"maint","command":"node scripts/server-backup.mjs plan-cleanup","summary":"基于冻结备份生成清理报告，不删除任何对象","flags":[{"flag":"--backup","meaning":"已核验的备份目录"},{"flag":"--destination","meaning":"新的报告文件（NDJSON）"},{"flag":"--retention-days","meaning":"保留天数，最少 30"}]},{"group":"maint","command":"node scripts/server-backup.mjs cleanup","summary":"按报告清理，默认试运行","flags":[{"flag":"--backup / --plan","meaning":"与报告对应的备份和报告文件"},{"flag":"--epoch","meaning":"当前冻结代号"},{"flag":"--apply","meaning":"真正删除，每次最多 20 个候选"}]},{"group":"maint","command":"node scripts/server-backup.mjs reconcile","summary":"核对冻结服务器上残留的上传预留","flags":[{"flag":"--epoch","meaning":"当前冻结代号"},{"flag":"--reservation ID","meaning":"选择记录，最多 10 条"},{"flag":"--apply","meaning":"执行核验后的恢复"}]},{"group":"maint","command":"node scripts/migrate-server-manifests.mjs","summary":"把 Linux 旧版内嵌清单迁到对象存储，可分批续做","flags":[{"flag":"--home","meaning":"服务器数据目录"},{"flag":"--batch N","meaning":"每批处理的数量"},{"flag":"--project ID --rollback","meaning":"回退仍保留内嵌正文的旧版本"}],"example":"node scripts/migrate-server-manifests.mjs --home /absolute/server/data --batch 50"}]},"integrity":"sha256-f2cb922c18c3fa9d4f1aab66332746643bedee46148b4975f3ca1e16a32d3f52"},"id":"node-7a84dab5"}