s://showai.renaissancemind.ai/doc/cloud"}}]},{"type":"text","text":"。"}],"attrs":{"id":"node-e614a0eb"}},{"type":"heading","attrs":{"level":2,"id":"node-e5149f58"},"content":[{"type":"text","text":"它在哪里运行，能做什么"}]},{"type":"paragraph","content":[{"type":"text","text":"点击图中的节点查看说明。关键点是：页面只通过项目绑定的 MCP 写入原项目，模型凭据只经过任务专属的本机网关。"}],"attrs":{"id":"node-6c0d2518"}},{"type":"widget","attrs":{"kind":"custom","data":{"componentId":"doc-diagram","version":"1.0.0","props":{"nodes":[{"id":"page","label":"页面","sub":"AI 入口","col":0,"row":1,"tone":"slate","icon":"📄","detail":"你在页面中发起请求。宿主把页面、稳定的块 ID 和选中文字一起交给执行者。"},{"id":"host","label":"Agent 宿主","sub":"ShowAI 应用","col":1,"row":1,"tone":"brand","detail":"负责启动执行者、保存对话记录和每轮发送前的页面版本（用于撤销本轮）。"},{"id":"local","label":"本机 Agent","sub":"Codex 等","col":2,"row":0,"tone":"violet","detail":"保留它自己的认证和运行配置，使用它自己的模型。","href":"https://showai.renaissancemind.ai/doc/agent-hosts"},{"id":"sdk","label":"Codex SDK","sub":"提供 LLM API","col":2,"row":2,"tone":"teal","detail":"ShowAI 按需安装的官方 Codex SDK。使用独立的 HOME、CODEX_HOME 和会话目录，只安装 ShowAI 插件；不继承你的 API Key、Codex 登录、技能或插件配置。命令执行使用 workspace-write 沙盒。"},{"id":"mcp","label":"项目 MCP","sub":"仅当前项目","col":3,"row":1,"tone":"brand","detail":"项目绑定的 MCP 连接。页面创建、保存、局部修改以及组件和模板工具在这个连接里授权执行。读写沿用当前 hash 和 revision。它不会接入整个内容库。"},{"id":"project","label":"项目","sub":"内容库","col":4,"row":1,"tone":"warm","icon":"🗂️","detail":"AI 的修改保存回原项目，和你在工作台里的编辑走同一套冲突处理。","href":"https://showai.renaissancemind.ai/doc/library"},{"id":"ws","label":"任务工作区","sub":"中间文件","col":3,"row":0,"tone":"slate","detail":"默认在 ~/Documents/ShowAI/Agent Workspaces 下，按项目和任务分开。每个对话固定使用一个工作区。"},{"id":"gateway","label":"本机网关","sub":"127.0.0.1","col":3,"row":2,"tone":"teal","detail":"读取模型供应商凭据并转发请求；Codex 子进程只拿到网关的任务凭据。Chat Completions 来源在这里完成格式转换。任务结束后关闭。"},{"id":"provider","label":"模型来源","sub":"ChatGPT 等","col":4,"row":2,"tone":"warm","detail":"你添加的模型服务。ChatGPT 授权只用于官方 Responses API。"}],"edges":[{"from":"page","to":"host","label":"请求"},{"from":"host","to":"local","label":"启动"},{"from":"host","to":"sdk","label":"启动"},{"from":"local","to":"mcp"},{"from":"sdk","to":"mcp"},{"from":"local","to":"ws","dashed":true},{"from":"sdk","to":"gateway","label":"任务凭据"},{"from":"gateway","to":"provider"},{"from":"mcp","to":"project","label":"读写页面"}],"groups":[{"label":"执行方式（二选一）","from":[2,0],"to":[2,2],"tone":"slate"}],"caption":"内置 Agent 的执行路径"},"integrity":"sha256-9ceb1b83b7337bd71c87cce10635d090629d4226ec970470ceee8ab26cee0038"},"id":"node-6d0d26ab"}},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"内置 Agent 的私有插件副本保留 8 个技能，但去掉了连接整个内容库的启动配置，所以它只能操作当前项目。"}],"attrs":{"id":"node-e8316d46"}}],"attrs":{"id":"node-6e9fd489"}},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"连接失败时不会改用 CLI 或另一个项目。"}],"attrs":{"id":"node-cbafe31"}}],"attrs":{"id":"node-6d9fd2f6"}},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"保存页面后它会生成展示文件，但内置对话目前只以文字和文件链接交付结果。"}],"attrs":{"id":"node-91e2f6fc"}}],"attrs":{"id":"node-6c9fd163"}},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"继续一个对话时，必须是同一个项目和同一个模型来源。"}],"attrs":{"id":"node-b7a9bc67"}}],"attrs":{"id":"node-6b9fcfd0"}}],"attrs":{"id":"node-6e0d283e"}},{"type":"toggle","attrs":{"title":"数据保存在哪里","open":false,"id":"node-6f0d29d1"},"content":[{"type":"table","content":[{"type":"tableRow","content":[{"type":"tableHeader","content":[{"type":"paragraph","content":[{"type":"text","text":"内容"}],"attrs":{"id":"node-d8323241"}}],"attrs":{"id":"node-bda2d7e6"}},{"type":"tableHeader","content":[{"type":"paragraph","content":[{"type":"text","text":"位置"}],"attrs":{"id":"node-330a0716"}}],"attrs":{"id":"node-bea2d979"}}],"attrs":{"id":"node-e5777d29"}},{"type":"tableRow","content":[{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"运行时与凭据"}],"attrs":{"id":"node-9a5bbdde"}}],"attrs":{"id":"node-e3699d51"}},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"应用数据目录下的 "},{"type":"text","text":"agent-host","marks":[{"type":"code"}]},{"type":"text","text":"（桌面版位于 Electron userData）"}],"attrs":{"id":"node-1e963409"}}],"attrs":{"id":"node-e2699bbe"}}],"attrs":{"id":"node-e4777b96"}},{"type":"tableRow","content":[{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"对话记录"}],"attrs":{"id":"node-a70ad9fb"}}],"attrs":{"id":"node-e8925f9c"}},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"agent-host/conversations/<项目>/","marks":[{"type":"code"}]},{"type":"text","text":"，执行过程中持续写入"}],"attrs":{"id":"node-81441490"}}],"attrs":{"id":"node-e992612f"}}],"attrs":{"id":"node-e3777a03"}},{"type":"tableRow","content":[{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"任务工作区"}],"attrs":{"id":"node-52757958"}}],"attrs":{"id":"node-d1bf087"}},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"默认为 "},{"type":"text","text":"~/Documents/ShowAI/Agent Workspaces","marks":[{"type":"code"}]},{"type":"text","text":"；开发时可用 "},{"type":"text","text":"SHOWAI_AGENT_WORKSPACES","marks":[{"type":"code"}]},{"type":"text","text":" 指定"}],"attrs":{"id":"node-d6ffa163"}}],"attrs":{"id":"node-c1beef4"}}],"attrs":{"id":"node-e2777870"}}],"attrs":{"id":"node-ea655e5e"}},{"type":"paragraph","content":[{"type":"text","text":"对话按项目保存，每一轮记录完整请求、作用对象、执行过程和页面结果。删除对话只删除记录，不影响页面内容。"}],"attrs":{"id":"node-eb655ff1"}}]},{"type":"heading","attrs":{"level":2,"id":"node-700d2b64"},"content":[{"type":"text","text":"安装与更新 Codex SDK"}]},{"type":"paragraph","content":[{"type":"text","text":"「提供 LLM API」 需要的 SDK 不随应用安装。在 「设置 → Agent → 内置执行能力」 点 「一键安装 Codex SDK」，以后用 「检查并安装新版」 更新。"}],"attrs":{"id":"node-710d2cf7"}},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"SDK 和平台包从官方 npm 注册表下载，核对 SHA-512 完整性后解包，不执行安装脚本。"}],"attr