":[{"type":"paragraph","content":[{"type":"text","text":"8.4 ms (101 items)"}],"attrs":{"id":"node-25b202a8"}}],"attrs":{"id":"node-8f082b77"}},{"type":"tableCell","content":[{"type":"paragraph","content":[{"type":"text","text":"37.3 ms"}],"attrs":{"id":"node-aad9fb73"}}],"attrs":{"id":"node-8e0829e4"}}],"attrs":{"id":"node-86e9c5ac"}}],"attrs":{"id":"node-146dce9f"}},{"type":"paragraph","content":[{"type":"text","text":"Content library size includes the committed repository, current readable projection, and local operation cache, measured before search indexing. The component version produces both compiled output and editable source code, so the component scene occupies the largest area."}],"attrs":{"id":"node-156dd032"}},{"type":"callout","attrs":{"icon":"🕰️","tone":"blue","id":"node-166dd1c5"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Both sets of measurements, Core reads and Storage writes, are done when the content library also uses a Git repository. The current content library starts with "},{"type":"text","text":"history/content.sqlite ","marks":[{"type":"code"}]},{"type":"text","text":"for authoritative storage (see "},{"type":"text","text":"Content Library & Versions","marks":[{"type":"link","attrs":{"href":"https://showai.renaissancemind.ai/doc/library"}}]},{"type":"text","text":"), these numbers should be taken as observed values ​​realized at that time."}],"attrs":{"id":"node-f8e8b62a"}}]},{"type":"heading","attrs":{"level":2,"id":"node-f6dc6c0"},"content":[{"type":"text","text":"Capacity limit"}]},{"type":"paragraph","content":[{"type":"text","text":"Capacity is calculated separately based on architectural boundaries, and binary resources are calculated based on decoded size. passed at runtime "},{"type":"text","text":"showai_capabilities ","marks":[{"type":"code"}]},{"type":"text","text":"of "},{"type":"text","text":"capacities ","marks":[{"type":"code"}]},{"type":"text","text":"Expose the same set of values."}],"attrs":{"id":"no