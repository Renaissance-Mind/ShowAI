{
  "type": "object",
  "properties": {
    "columns": {
      "type": "integer",
      "enum": [
        2,
        3,
        4
      ]
    },
    "variant": {
      "type": "string",
      "enum": [
        "tile",
        "row"
      ]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "type": "string",
            "enum": [
              "brand",
              "teal",
              "warm",
              "violet",
              "rose",
              "slate"
            ]
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cards"
  ],
  "additionalProperties": false
}
