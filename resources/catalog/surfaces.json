[
  {
    "kind": "page",
    "name": "页面",
    "description": "按顺序组织文字、图片和组件，可嵌入页面或白板，也可展开编辑。",
    "scenarios": [
      "文章、报告和说明页面。",
      "在白板上放入一份可编辑的文档。"
    ],
    "effects": [
      "原生文字编辑与纵向阅读。",
      "与白板互相嵌套，展开后编辑同一份内容。"
    ],
    "version": "1.0.0",
    "insertion": {
      "nodeType": "surface",
      "surfaceKind": "page"
    },
    "defaultData": {
      "title": "Page"
    },
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "content": {
          "type": "array",
          "maxItems": 12000,
          "items": {
            "type": "object"
          }
        },
        "layout": {
          "type": "object"
        },
        "surfaceViews": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "examples": [
      {
        "name": "空白页面",
        "data": {
          "title": "Page"
        }
      },
      {
        "name": "内容示例",
        "data": {
          "title": "内容示例",
          "content": [
            {
              "type": "richText",
              "attrs": {
                "id": "example-content",
                "name": "内容"
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "文字、图片和组件都可以放在这里。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "kind": "board",
    "name": "白板",
    "description": "在独立空间中摆放组件和绘画，可嵌入页面或其他白板。",
    "scenarios": [
      "在文档中嵌入一块分析白板。",
      "组织页面、图片和组件之间的空间关系。"
    ],
    "effects": [
      "独立平移、缩放、吸附与绘画。",
      "支持在内部放入页面，并逐层展开。"
    ],
    "version": "1.0.0",
    "insertion": {
      "nodeType": "surface",
      "surfaceKind": "board"
    },
    "defaultData": {
      "title": "Board"
    },
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "content": {
          "type": "array",
          "maxItems": 12000,
          "items": {
            "type": "object"
          }
        },
        "layout": {
          "type": "object"
        },
        "surfaceViews": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "examples": [
      {
        "name": "空白白板",
        "data": {
          "title": "Board"
        }
      },
      {
        "name": "内容示例",
        "data": {
          "title": "内容示例",
          "content": [
            {
              "type": "richText",
              "attrs": {
                "id": "example-content",
                "name": "内容"
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "文字、图片和组件都可以放在这里。"
                    }
                  ]
                }
              ]
            }
          ],
          "layout": {
            "example-content": {
              "x": 0,
              "y": 0,
              "width": 360
            }
          }
        }
      }
    ]
  },
  {
    "kind": "region",
    "name": "布局容器",
    "description": "不显示标题或外框的原生布局容器，组合文字、图像与组件；按可用宽度自动减少列数。",
    "scenarios": [
      "把图与解释、并列方案或若干组件组织在同一个布局中。",
      "在桌面多栏、手机单栏之间自适应，也适用于嵌套窄列。"
    ],
    "effects": [
      "只呈现子内容，没有标题条、背景和额外内边距。",
      "列数是上限；空间不足时按每列最小宽度换行，保持内容顺序。",
      "保留原生 region 和子节点 ID，复用现有设置、选中和右键动作。"
    ],
    "version": "1.0.0",
    "insertion": {
      "nodeType": "region"
    },
    "defaultData": {
      "mode": "grid",
      "columns": 2,
      "gap": 24,
      "minColumnWidth": 320
    },
    "propsSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "mode": {
          "enum": [
            "flow",
            "grid",
            "free"
          ],
          "default": "grid"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 2
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 160,
          "default": 24
        },
        "minColumnWidth": {
          "type": "number",
          "minimum": 120,
          "maximum": 1200,
          "default": 320
        },
        "blocks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "type": "object"
              }
            },
            "required": [
              "kind",
              "data"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "examples": [
      {
        "name": "双栏图文",
        "request": "把图与解释放在同一个布局容器，窄屏自动排成单列。",
        "data": {
          "columns": 2,
          "minColumnWidth": 320,
          "gap": 24,
          "blocks": [
            {
              "kind": "text",
              "data": {
                "format": "markdown",
                "content": "### 方案 A\n\n这里可以放图、表或其他组件。"
              }
            },
            {
              "kind": "text",
              "data": {
                "format": "markdown",
                "content": "### 方案 B\n\n对应的解释随容器宽度换行排列。"
              }
            }
          ]
        }
      },
      {
        "name": "空白纵向分组",
        "data": {
          "mode": "flow"
        }
      }
    ]
  }
]
