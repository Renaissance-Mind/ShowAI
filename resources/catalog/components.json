        },
        "resultLabel": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "inputs",
        "operation"
      ]
    },
    "examples": [
      {
        "name": "矩形面积",
        "request": "让读者调整矩形长宽并观察面积。",
        "data": {
          "title": "矩形面积",
          "inputs": [
            {
              "id": "length",
              "label": "长",
              "min": 1,
              "max": 10,
              "step": 1,
              "value": 3,
              "unit": "m"
            },
            {
              "id": "width",
              "label": "宽",
              "min": 1,
              "max": 10,
              "step": 1,
              "value": 4,
              "unit": "m"
            }
          ],
          "operation": "product",
          "resultLabel": "面积",
          "unit": "m²"
        }
      }
    ],
    "version": "1.0.0",
    "effects": [
      "输入变化会立即更新结果，帮助读者理解变量之间的关系。",
      "默认参数、单位和范围明确，读者可以重置探索过程；阅读时的试算不更改页面原始数据。"
    ]
  },
