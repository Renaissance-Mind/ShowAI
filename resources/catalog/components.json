[
  {
    "kind": "chart",
    "name": "数据图表",
    "description": "交互式折线图、柱状图和可展开的原始数据。",
    "scenarios": [
      "展示有明确横轴顺序的数值变化，例如某实验在各个训练步的损失或一段时间的请求量。",
      "比较同一指标下的多个选项，例如使用相同测评集得到的模型成绩；只有可比口径的数据才放在同一图中。"
    ],
    "defaultData": {
      "title": "数据图表",
      "type": "line",
      "labels": [],
      "series": [],
      "unit": ""
    },
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "line",
            "bar"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "color": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "values"
            ]
          }
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "labels",
        "series"
      ]
    },
    "examples": [
      {
        "name": "线性函数 y=x",
        "data": {
          "title": "y = x",
          "type": "line",
          "labels": [
            "0",
            "1",
            "2"
          ],
          "series": [
            {
              "name": "y = x",
              "values": [
                0,
                1,
                2
              ]
            }
          ]
        },
        "request": "用折线展示线性函数y=x在0、1、2处的值，并允许切换图表类型。"
      }
    ],
    "version": "1.0.0",
    "effects": [
      "把趋势、峰值和序列间差异变成可直接观察的图形。",
      "通过切换折线或柱状图、显示或隐藏序列、查看原始数据，帮助读者核对结论。"
    ]
  },
  {
    "kind": "database",
    "name": "数据库",
    "description": "带筛选、排序和看板视图的表格。单元格支持文字、数字、选择、复选框和链接。",
    "scenarios": [
      "整理可按字段比较的记录，例如论文的任务、方法、数据集与来源链接。",
      "跟踪有阶段状态的事项，例如待阅读、已阅读、已复现的论文清单。"
    ],
    "defaultData": {
      "title": "数据库",
      "columns": [
        {
          "id": "name",
          "name": "名称",
          "type": "text"
        }
      ],
      "rows": []
    },
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "text",
                  "number",
                  "select",
                  "checkbox",
                  "url"
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name",
              "type"
            ]
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "groupBy": {
          "type": "string"
        }
      },
      "required": [
        "columns",
        "rows"
      ]
    },
    "examples": [
      {
        "name": "平方值记录",
        "request": "把0、1、2的平方列成可排序的表格。",
        "data": {
          "title": "平方值",
          "columns": [
            {
              "id": "x",
              "name": "x",
              "type": "number"
            },
            {
              "id": "square",
              "name": "x²",
              "type": "number"
            }
          ],
          "rows": [
            {
              "id": "n0",
              "x": 0,
              "square": 0
            },
            {
              "id": "n1",
              "x": 1,
              "square": 1
            },
            {
              "id": "n2",
              "x": 2,
              "square": 4
            }
          ]
        }
      }
    ],
    "version": "1.0.0",
    "effects": [
      "让读者筛选、排序和搜索一组记录，检查具体证据。",
      "同一份数据可切换表格或看板，分别呈现属性对比和状态分组。"
    ]
  },
  {
    "kind": "metrics",
    "name": "关键指标",
    "description": "显示有来源的数值、单位、变化和说明。",
    "scenarios": [
      "突出少量已核实的关键数字，例如实验样本数、运行时长或比较结果。",
      "在长报告开头帮助读者识别最重要的量及单位；数据缺失时保留说明，不补造数字。"
    ],
    "defaultData": {
      "title": "关键指标",
      "items": []
    },
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "unit": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "trend": {
                "type": "number"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        }
      },
      "required": [
        "items"
      ]
    },
    "examples": [
      {
        "name": "边长为3米的正方形",
        "request": "突出这个正方形的边长、面积和周长。",
        "data": {
          "title": "正方形",
          "items": [
            {
              "label": "边长",
              "value": 3,
              "unit": "m"
            },
            {
              "label": "面积",
              "value": 9,
              "unit": "m²",
              "detail": "3 × 3"
            },
            {
              "label": "周长",
              "value": 12,
              "unit": "m",
              "detail": "4 × 3"
            }
          ]
        }
      }
    ],
    "version": "1.0.0",
    "effects": [
      "用简短标签、数值和说明提高关键数字的可读性。",
      "可呈现有依据的变化比例，同时保留口径说明。"
    ]
  },
  {
    "kind": "playground",
    "name": "交互计算",
    "description": "用滑块探索求和、乘积或平均值。",
    "scenarios": [
      "解释几个输入怎样影响结果，例如矩形的长宽与面积、不同开销项与总成本。",
      "让读者在限定范围内探索求和、乘积或平均值，检查参数敏感性。"
    ],
    "defaultData": {
      "title": "交互计算",
      "inputs": [],
      "operation": "sum",
      "resultLabel": "计算结果",
      "unit": ""
    },
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
