              "id": {
                "type": "string"
              },
              "src": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              }
            },
            "required": ["src"]
          }
        }
      },
      "required": ["images"]
    },
    "examples": []
  },
