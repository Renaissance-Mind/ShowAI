{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "showai-agent",
  "main": "agent-worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "vars": {
    "SHOWAI_AGENT_URL": "https://run.showai.renaissancemind.ai",
    "SHOWAI_AGENT_SYNC_SERVERS": "https://showai.renaissancemind.ai/cloud",
    "SHOWAI_AGENT_SYNC_SERVICE_URL": "https://showai.renaissancemind.ai/cloud",
  },
  "routes": [
    { "pattern": "run.showai.renaissancemind.ai", "custom_domain": true },
  ],
  "durable_objects": {
    "bindings": [{ "name": "AGENTS", "class_name": "ShowAIAgentGateway" }],
  },
  "migrations": [
    { "tag": "agent-v1", "new_sqlite_classes": ["ShowAIAgentGateway"] },
  ],
  "containers": [
    {
      "class_name": "ShowAIAgentGateway",
      "image": "registry.cloudflare.com/8f1753ad2d5e392716033248d7c5639e/showai-agent-showaiagentgateway@sha256:50fdacfdbd7b868726c8423e3745f01555cc14d2cf350a311c60cafa53396119",
      "instance_type": "standard-1",
      "max_instances": 10,
    },
  ],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "showai-agent-state" }],
  "services": [{ "binding": "CONTENT_SERVER", "service": "showai-cloud" }],
  "observability": { "enabled": true },
}