{
  "name": "showai-cloud",
  "main": "../../dist-server/worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "placement": { "region": "aws:ap-southeast-1" },
  "durable_objects": {
    "bindings": [{ "name": "SERVER", "class_name": "ShowAIServer" }],
  },
  "migrations": [
    { "tag": "showai-server-v1", "new_sqlite_classes": ["ShowAIServer"] },
  ],
  "limits": { "cpu_ms": 5000 },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false },
  },
  "vars": {
    "SHOWAI_SERVER_NAME": "ShowAI Cloud",
    "SHOWAI_SERVER_URL": "https://showai.renaissancemind.ai/cloud",
    "SHOWAI_OBSERVE": "1",
    "SHOWAI_METADATA_DRIVER": "durable",
    "SHOWAI_METADATA_IMPORT_REQUIRED": "1",
  },
  "routes": [
    {
      "pattern": "https://showai.renaissancemind.ai/cloud",
      "zone_name": "renaissancemind.ai",
    },
    {
      "pattern": "https://showai.renaissancemind.ai/cloud/*",
      "zone_name": "renaissancemind.ai",
    },
  ],
  "ratelimits": [
    {
      "name": "REQUEST_RATE",
      "namespace_id": "10231",
      "simple": { "limit": 6000, "period": 60 },
    },
    {
      "name": "SOURCE_RATE",
      "namespace_id": "10232",
      "simple": { "limit": 12000, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "showai-cloud",
      "database_id": "b9657b08-2c3d-4bb3-97db-5c352a9e93eb",
      "migrations_dir": "../../dist-server/migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "CONTENT", "bucket_name": "showai-cloud-content" },
  ],
  "env": {
    "staging": {
      "name": "showai-cloud-staging",
      "vars": {
        "SHOWAI_SERVER_NAME": "ShowAI Cloud Staging",
        "SHOWAI_SERVER_URL": "https://showai.renaissancemind.ai/cloud-staging",
        "SHOWAI_REGISTRATION_LIMIT": "120",
        "SHOWAI_OBSERVE": "1",
        "SHOWAI_METADATA_DRIVER": "durable",
        "SHOWAI_METADATA_IMPORT_REQUIRED": "1",
      },
      "durable_objects": {
        "bindings": [{ "name": "SERVER", "class_name": "ShowAIServer" }],
      },
      "routes": [
        {
          "pattern": "https://showai.renaissancemind.ai/cloud-staging",
          "zone_name": "renaissancemind.ai",
        },
        {
          "pattern": "https://showai.renaissancemind.ai/cloud-staging/*",
          "zone_name": "renaissancemind.ai",
        },
      ],
      "ratelimits": [
        {
          "name": "REQUEST_RATE",
          "namespace_id": "20231",
          "simple": { "limit": 6000, "period": 60 },
        },
        {
          "name": "SOURCE_RATE",
          "namespace_id": "20232",
          "simple": { "limit": 12000, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "showai-cloud-staging",
          "database_id": "ffcb7872-fd46-460d-891e-0c6792a6183d",
          "migrations_dir": "../../dist-server/migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "CONTENT", "bucket_name": "showai-cloud-staging-content" },
      ],
    },
  },
}
