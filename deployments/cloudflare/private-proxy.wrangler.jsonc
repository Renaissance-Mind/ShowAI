{
  "name": "showai-private-proxy",
  "main": "../../dist-server/private-proxy.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  // PRIVATE_ORIGIN is the HTTPS origin of the private Linux server. It is not
  // committed; supply it at deploy time, for example:
  //   wrangler deploy -c deployments/cloudflare/private-proxy.wrangler.jsonc \
  //     --var PRIVATE_ORIGIN:https://origin.example.com
  // PROXY_KEY is a secret (`wrangler secret put PROXY_KEY`) matching the
  // server's SHOWAI_TRUSTED_PROXY_KEY so per-visitor rate limits apply.
  "routes": [
    {
      "pattern": "https://showai.renaissancemind.ai/private",
      "zone_name": "renaissancemind.ai",
    },
    {
      "pattern": "https://showai.renaissancemind.ai/private/*",
      "zone_name": "renaissancemind.ai",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
  },
}
