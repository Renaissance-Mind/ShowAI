{
  "name": "showai",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Offline desktop canvas with file-based projects and Agent tools.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev.mjs desktop",
    "dev:browser": "node scripts/dev.mjs browser",
    "dev:open": "node scripts/dev-open.mjs",
    "dev:status": "node scripts/dev-open.mjs --status",
    "dev:install": "node scripts/install-dev-app.mjs",
    "test:dev": "node scripts/dev-smoke.mjs",
    "test:history": "node scripts/history-smoke.mjs",
    "build:portable": "vite build --config vite.portable.config.ts && node scripts/copy-viewer.mjs && node scripts/build-index-worker.mjs",
    "build": "tsc -b && npm run build:portable && vite build && npm run build:agent && npm run package:runtime && npm run package:plugin && npm run desktop:build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --maxWorkers=4 --testTimeout=30000 --hookTimeout=30000",
    "build:server": "node scripts/build-server.mjs",
    "server": "node dist-server/server.mjs",
    "test:server": "vitest run src/server/server.test.ts src/server/portable-contract.test.ts src/sync/manager.test.ts --maxWorkers=2 --testTimeout=30000 --hookTimeout=30000",
    "artifact": "node scripts/render-artifact.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write src scripts docs README.md *.ts *.json *.html",
    "build:agent": "node scripts/build-agent.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "node scripts/run-desktop.mjs",
    "package:mac": "npm run build && electron-builder --mac --arm64 --config electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "pretest": "npm run build:portable",
    "test:desktop": "npm run build && node src/desktop/smoke.mjs && node src/desktop/ui-smoke.mjs && node src/desktop/library-ui-smoke.mjs && node src/desktop/catalog-ui-smoke.mjs",
    "plugin:install": "node scripts/install-codex-plugin.mjs",
    "plugin:update": "node scripts/install-codex-plugin.mjs --update",
    "package:runtime": "node scripts/package-runtime.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "runtime:register": "node dist-runtime/scripts/cli.mjs runtime register --json",
    "build:browser": "tsc -b && npm run build:portable && vite build && npm run build:agent && npm run package:runtime",
    "browser": "node dist-runtime/scripts/cli.mjs serve",
    "package:browser": "npm run build:browser && node scripts/package-browser.mjs",
    "test:browser": "npm run build:portable && vitest run src/browser/server.test.ts",
    "test:browser:package": "node scripts/browser-package-smoke.mjs",
    "test:component-gallery": "npm run build && node src/desktop/component-gallery-ui-smoke.mjs",
    "test:whiteboard": "npm run test:containers",
    "test:whiteboard:desktop": "npm run test:containers:desktop",
    "test:containers": "node scripts/containers-smoke.mjs",
    "test:containers:desktop": "node scripts/containers-smoke.mjs --desktop"
  },
  "dependencies": {
    "@antv/g-svg": "2.1.1",
    "@antv/g2": "5.4.8",
    "@antv/g2-extension-plot": "0.2.2",
    "@dagrejs/dagre": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "d3-interpolate": "3.0.1",
    "d3-regression": "2.2.0",
    "dugite": "3.2.3",
    "esbuild": "^0.28.2",
    "katex": "0.19.0",
    "lucide-react": "^1.50.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "3.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-desktop/main.mjs",
  "bin": {
    "showai": "dist-agent/cli.mjs"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  },
  "allowScripts": {
    "dugite@3.2.3": true
  }
}
