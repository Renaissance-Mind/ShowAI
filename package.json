{
  "name": "showai",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Offline desktop canvas with file-based projects and Agent tools.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:portable": "vite build --config vite.portable.config.ts && node scripts/copy-viewer.mjs",
    "build": "tsc -b && npm run build:portable && vite build && npm run build:agent && node scripts/package-plugin.mjs && npm run desktop:build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "artifact": "node scripts/render-artifact.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write src scripts docs README.md *.ts *.json *.html",
    "build:agent": "node scripts/build-agent.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "node scripts/run-desktop.mjs",
    "package:mac": "npm run build && electron-builder --mac --arm64 --config electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "pretest": "npm run build:portable",
    "test:desktop": "npm run build && node src/desktop/smoke.mjs && node src/desktop/ui-smoke.mjs && node src/desktop/library-ui-smoke.mjs && node src/desktop/catalog-ui-smoke.mjs",
    "plugin:install": "node scripts/install-codex-plugin.mjs",
    "plugin:update": "node scripts/install-codex-plugin.mjs --update"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.50.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-desktop/main.mjs",
  "bin": {
    "showai": "dist-agent/cli.mjs"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
