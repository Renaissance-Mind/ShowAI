{
  "mcpServers": {
    "showai": {
      "tools": {
        "show_component": {
          "eager": true
        }
      },
      "command": "node",
      "args": [
        "./mcp/launch.mjs"
      ],
      "cwd": "./",
      "env": {
        "SHOWAI_HOST_DISPLAY": "mcp-app",
        "SHOWAI_ANTIGRAVITY_WORKBENCH": "1"
      }
    }
  }
}
