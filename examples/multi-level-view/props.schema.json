{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "可访问的容器名称"
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "根视图 ID"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "description": "完整的层级结构，包括子组件及其进入事件",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "整个组件内唯一的视图 ID"
          },
          "parentId": {
            "type": ["string", "null"],
            "description": "父视图 ID，根视图为 null"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "层级路径中的名称"
          },
          "component": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["flowchart", "layer-diagram"],
                "description": "已注册的子组件类型"
              },
              "props": {
                "type": "object",
                "additionalProperties": true,
                "description": "该子组件的原生数据，格式由 kind 对应的组件 schema 定义"
              }
            },
            "required": ["kind", "props"]
          },
          "bindings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": ["node", "module"],
                      "description": "组件公开的对象类型"
                    },
                    "scope": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "description": "Flowchart 的 flow.id 或 LayerDiagram 的 layer.id"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "description": "节点 id 或模块 id"
                    }
                  },
                  "required": ["type", "scope", "id"]
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "直接子视图 ID"
                }
              },
              "required": ["source", "to"]
            },
            "description": "单击对象进入子视图的事件绑定；空数组保留子组件本来的阅读操作"
          }
        },
        "required": ["id", "parentId", "label", "component", "bindings"]
      }
    }
  },
  "required": ["title", "root", "levels"]
}
