{
  "id": "multi-level-view",
  "name": "多级组件视图",
  "version": "1.1.1",
  "description": "轻量的多级视图容器：每层组合原生组件，用稳定节点事件逐层展开，只有路径、返回和切换过渡。",
  "scenarios": [
    "软件架构从总览进入模块框图、业务流程和子结构。",
    "把流程、架构图、文字和图表组合成可展开的结构。"
  ],
  "entry": "index.jsx",
  "reader": "readData",
  "defaultData": {
    "title": "多级组件视图",
    "root": "system",
    "levels": [
      {
        "id": "system",
        "parentId": null,
        "label": "软件系统",
        "component": {
          "kind": "flowchart",
          "props": {
            "height": 390,
            "flows": [
              {
                "id": "system",
                "label": "流程",
                "direction": "LR",
                "nodes": [
                  {
                    "id": "client",
                    "label": "用户入口",
                    "kind": "query"
                  },
                  {
                    "id": "services",
                    "label": "业务服务",
                    "kind": "query"
                  },
                  {
                    "id": "storage",
                    "label": "数据设施",
                    "kind": "query"
                  }
                ],
                "edges": [
                  {
                    "id": "e0",
                    "source": "client",
                    "target": "services"
                  },
                  {
                    "id": "e1",
                    "source": "services",
                    "target": "storage"
                  }
                ]
              }
            ]
          }
        },
        "bindings": [
          {
            "source": {
              "type": "node",
              "scope": "system",
              "id": "client"
            },
            "to": "clients"
          },
          {
            "source": {
              "type": "node",
              "scope": "system",
              "id": "services"
            },
            "to": "services"
          },
          {
            "source": {
              "type": "node",
              "scope": "system",
              "id": "storage"
            },
            "to": "storage"
          }
        ]
      },
      {
        "id": "clients",
        "parentId": "system",
        "label": "用户入口",
        "component": {
          "kind": "layer-diagram",
          "props": {
            "layers": [
              {
                "id": "channels",
                "name": "访问终端",
                "tone": "accent",
                "modules": [
                  {
                    "id": "web",
                    "name": "Web 应用",
                    "detail": "浏览、检索与订单操作。"
                  },
                  {
                    "id": "mobile",
                    "name": "移动端",
