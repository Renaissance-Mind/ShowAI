                  }
                ]
              },
              {
                "id": "access",
                "name": "接入服务",
                "tone": "teal",
                "modules": [
                  {
                    "id": "gateway",
                    "name": "API 网关",
                    "detail": "路由、鉴权与限流。"
                  },
                  {
                    "id": "session",
                    "name": "会话管理",
                    "detail": "维护当前用户的访问身份。"
                  }
                ]
              }
            ]
          }
        },
        "bindings": []
