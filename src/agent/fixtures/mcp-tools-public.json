[
  {
    "name": "showai_capabilities",
    "description": "Connection capabilities. view=presentation returns display and component limit.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "enum": [
            "presentation",
            "full"
          ]
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ]
    }
  },
  {
    "name": "public_catalog_list",
    "description": "Search the requested catalog. view=compact lists IDs and scenarios.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "component",
            "template"
          ]
        },
        "query": {
          "type": "string"
        },
        "view": {
          "type": "string",
          "enum": [
            "compact",
            "detailed"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ]
    }
  },
  {
    "name": "public_catalog_describe",
    "description": "Read a requested catalog item. view=guide gives its usage.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha256-[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "component",
            "template"
          ]
        },
        "view": {
          "type": "string",
          "enum": [
            "summary",
            "guide",
            "development",
            "parameters",
            "contract",
            "schema",
            "examples",
            "source",
            "dependencies",
            "full"
          ]
        },
        "parameterPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "parameterOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parameterLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "objectOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objectLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "knownHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "file": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ]
    }
  },
  {
    "name": "render_document",
    "description": "Render standalone content without saving.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "document": {
          "description": "ShowAI document; see the installed use-showai Skill's document format reference.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "templateId": {
          "description": "Public template ID.",
          "type": "string"
        },
        "templateVersion": {
          "type": "string"
        },
        "templateIntegrity": {
          "type": "string",
          "pattern": "^sha256-[a-f0-9]{64}$"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "componentSources": {
          "description": "Packages: manifest/schema/source/files/assets.",
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "blockIds": {
          "description": "Inline selection; HTML/source stay complete.",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "ui": {
        "resourceUri": "ui://showai/reader-v5.html"
      },
      "openai/outputTemplate": "ui://showai/reader-v5.html",
      "openai/toolInvocation/invoking": "正在生成 ShowAI 页面",
      "openai/toolInvocation/invoked": "ShowAI 页面已就绪"
    }
  },
  {
    "name": "show_component",
    "description": "Render 1–5 original HTML visuals. Use kind/data or blocks for requested catalog components.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "html": {
          "description": "Original HTML/CSS/JS. Optional data is window.showaiData.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "minItems": 1,
              "maxItems": 5,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "html": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "data": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "html"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          ]
        },
        "live": {
          "description": "Live catalog view in MCP Apps.",
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "description": "Single visual inputs or catalog props.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "blocks": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "kind",
              "data"
            ]
          }
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "componentSources": {
          "description": "Editable source packages.",
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "delivery": {
          "description": "auto follows the host.",
          "type": "string",
          "enum": [
            "auto",
            "mcp-app",
            "fragment-file",
            "compact",
            "image"
          ]
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "anthropic/alwaysLoad": true,
      "ui": {
        "resourceUri": "ui://showai/component-v3.html"
      },
      "openai/outputTemplate": "ui://showai/component-v3.html",
      "openai/toolInvocation/invoking": "正在生成 ShowAI 组件",
      "openai/toolInvocation/invoked": "ShowAI 组件已就绪"
    }
  },
  {
    "name": "show_component_update",
    "description": "Apply page_apply operations to a live view; complete finalizes it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operations": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "viewId",
        "operationId",
        "baseRevision",
        "operations"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ]
    }
  },
  {
    "name": "show_component_read",
    "description": "Read live view; source returns portable content to save.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sinceRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source": {
          "type": "boolean"
        }
      },
      "required": [
        "viewId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ]
    }
  },
  {
    "name": "show_component_close",
    "description": "Release temporary view.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "viewId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ]
    }
  }
]
